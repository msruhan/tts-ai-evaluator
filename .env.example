SUMOPOD_API_KEY=sk-your_sumopod_api_key_here
SUMOPOD_MODEL=gemini/gemini-3.5-flash
SUMOPOD_BASE_URL=https://ai.sumopod.com/v1

# Optional — leave empty for local file storage (data/)
# Fill both to use Supabase (recommended for Vercel)
NEXT_PUBLIC_SUPABASE_URL=
# Prefer Legacy API Key "service_role" (starts with eyJ...) on Vercel
# if you see error: JWT issued at future
SUPABASE_SERVICE_ROLE_KEY=
