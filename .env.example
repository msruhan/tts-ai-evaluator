SUMOPOD_API_KEY=sk-your_sumopod_api_key_here
SUMOPOD_MODEL=gemini/gemini-3.5-flash
SUMOPOD_BASE_URL=https://ai.sumopod.com/v1

# Optional — leave empty for local file storage (data/)
# Fill both to use Supabase (recommended for Vercel)
NEXT_PUBLIC_SUPABASE_URL=
# Prefer Legacy API Key "service_role" (starts with eyJ...) on Vercel
# if you see error: JWT issued at future
SUPABASE_SERVICE_ROLE_KEY=

# Fact Check (/fact-check) — runs locally only, via Codex CLI (ChatGPT login)
TAVILY_API_KEY=
# Optional: path to codex binary (default: PATH, then ChatGPT.app bundle)
CODEX_BIN=
# Optional: override model from ~/.codex/config.toml
CODEX_MODEL=
CODEX_REASONING_EFFORT=low

# Login (satu akun untuk semua modul). AUTH_SECRET minimal 32 karakter: openssl rand -hex 32
AUTH_USERNAME=
AUTH_PASSWORD=
AUTH_SECRET=
